{
  "name": "@snacking/animation-library",
  "version": "1.0.0",
  "description": "A React library for creating interactive eating animations, loaders, progress indicators, and delete animations",
  "type": "module",
  "main": "./dist/snacking-animation-library.cjs.js",
  "module": "./dist/snacking-animation-library.es.js",
  "types": "./dist/snacking-animation-library.d.ts",
  "exports": {
    ".": {
      "types": "./dist/snacking-animation-library.d.ts",
      "import": "./dist/snacking-animation-library.es.js",
      "require": "./dist/snacking-animation-library.cjs.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "EXAMPLES.md"
  ],
  "keywords": [
    "react",
    "animation",
    "eating",
    "loader",
    "progress",
    "interactive",
    "svg",
    "particles"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/snacking-animation-library"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "tsc && vite build -c vite.config.lib.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^5.0.2"
  }
}
